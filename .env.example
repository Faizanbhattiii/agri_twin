# AgriTwin Pakistan — Environment Configuration Template
# Copy to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=agritwin-dev-secret-key-change-in-production

# Timezone
TIMEZONE=Asia/Karachi

# Database Configuration (PostgreSQL default, falls back to SQLite if empty)
# Example: postgresql+psycopg2://postgres:postgres@localhost:5432/agritwin
DATABASE_URL=sqlite:///./data/agritwin.db

# Open-Meteo Configuration (Free tier CC BY 4.0, attribution required)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Google Earth Engine / Sentinel-2 Configuration (Optional, fallback to cached fixtures if omitted)
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

# SoilGrids Configuration (ISRIC REST API)
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# IoT Field Node / Telemetry Security
FIELD_NODE_API_KEY=dev-node-api-key-test-12345
TELEMETRY_INTERVAL_MINUTES=15

# Pilot Research Field Configuration
PILOT_FIELD_ID=pilot-faisalabad-01
PILOT_LATITUDE=31.4289
PILOT_LONGITUDE=73.0782
PILOT_AREA_ACRES=5.0
